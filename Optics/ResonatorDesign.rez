    "formulas": [
        {
            "code": "Arm_Width / sin(2 * Angle_QS)",
            "param_deps": [
                "Arm_Width",
                "Angle_QS"
            ],
            "target_param": "Arm_Gain_QS"
        },
        {
            "code": "M2_ROC / 2 + KTP_Confocal",
            "param_deps": [
                "M2_ROC",
                "KTP_Confocal"
            ],
            "target_param": "Arm_KTP"
        },
        {
            "code": "Arm_Width / sin(2 * Angle_KTP)",
            "param_deps": [
                "Angle_KTP",
                "Arm_Width"
            ],
            "target_param": "Arm_KTP_Gain"
        },
        {
            "code": "(M5_ROC / 2) + QS_Confocal",
            "param_deps": [
                "M5_ROC",
                "QS_Confocal"
            ],
            "target_param": "Arm_QS"
        },
        {
            "code": "Arm_KTP + Arm_KTP_Gain + Arm_Gain + Arm_Gain_QS + Arm_QS",
            "param_deps": [
                "Arm_Gain",
                "Arm_Gain_QS",
                "Arm_KTP",
                "Arm_KTP_Gain",
                "Arm_QS"
            ],
            "target_param": "Cavity_Length"
        },
        {
            "code": "QS_Offset",
            "param_deps": [
                "QS_Offset"
            ],
            "target_param": "d_qs_m6"
        },
        {
            "code": "(Arm_Gain - Gain_L) / 2",
            "param_deps": [
                "Arm_Gain",
                "Gain_L"
            ],
            "target_param": "d_gain_m4"
        },
        {
            "code": "Arm_KTP - KTP_L - KTP_Offset",
            "param_deps": [
                "Arm_KTP",
                "KTP_L",
                "KTP_Offset"
            ],
            "target_param": "d_ktp_m2"
        },
        {
            "code": "KTP_Offset",
            "param_deps": [
                "KTP_Offset"
            ],
            "target_param": "d_m1_ktp"
        },
        {
            "code": "Arm_KTP_Gain",
            "param_deps": [
                "Arm_KTP_Gain"
            ],
            "target_param": "d_m2_m3"
        },
        {
            "code": "(Arm_Gain - Gain_L) / 2",
            "param_deps": [
                "Arm_Gain",
                "Gain_L"
            ],
            "target_param": "d_m3_gain"
        },
        {
            "code": "Arm_Gain_QS",
            "param_deps": [
                "Arm_Gain_QS"
            ],
            "target_param": "d_m4_m5"
        },
        {
            "code": "Arm_QS - QS_L - QS_Offset",
            "param_deps": [
                "QS_L",
                "QS_Offset",
                "Arm_QS"
            ],
            "target_param": "d_m5_qs"
        }
    ],
